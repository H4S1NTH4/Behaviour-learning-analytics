# Behavioral Analytics Client Configuration
# Copy this file to .env and update with your values

# API Endpoint for keystroke data submission
# Development: http://localhost:3000/api/keystroke
# Production: https://your-domain.com/api/keystroke
API_ENDPOINT=http://localhost:3000/api/keystroke

# Enable debug logging (true/false)
DEBUG=true

# Environment (development/production/testing)
ENVIRONMENT=development

# Optional: Application-specific configuration
# ASSIGNMENT_ID=default-assignment
# BATCH_SIZE_LIMIT=100
# BATCH_TIME_LIMIT=5000
# ENABLE_CONSENT=true

# Note: Environment variable naming depends on your build tool:
# - Vite: prefix with VITE_ (e.g., VITE_API_ENDPOINT)
# - Create React App: prefix with REACT_APP_ (e.g., REACT_APP_API_ENDPOINT)
# - Next.js: prefix with NEXT_PUBLIC_ (e.g., NEXT_PUBLIC_API_ENDPOINT)
