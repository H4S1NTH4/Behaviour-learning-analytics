# ==================================
# DATABASE CONFIGURATION
# ==================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=behavioral_analytics
DB_USER=postgres
DB_PASSWORD=change_me_secure_password
DB_POOL_SIZE=20
DB_MAX_CONNECTIONS=200
DB_IDLE_TIMEOUT=10000
DB_CONNECTION_TIMEOUT=5000

# ==================================
# API SERVER CONFIGURATION
# ==================================
API_PORT=3000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3000
API_ENDPOINT=http://localhost:3000/api/v1/keystrokes/log
API_CORS_ORIGIN=http://localhost:5173,http://localhost:3002
API_RATE_LIMIT_WINDOW=15
API_RATE_LIMIT_MAX=1000

# ==================================
# INFERENCE ENGINE CONFIGURATION
# ==================================
INFERENCE_PORT=3001
INFERENCE_HOST=0.0.0.0
INFERENCE_BASE_URL=http://localhost:3001
INFERENCE_BATCH_SIZE=32
INFERENCE_BUFFER_SIZE=100
INFERENCE_PROCESSING_INTERVAL=5000
ML_MODEL_PATH=/app/models
LSTM_MODEL_PATH=/app/models/lstm_model.h5
FEATURE_SCALER_PATH=/app/models/scaler.pkl

# ==================================
# DASHBOARD CONFIGURATION
# ==================================
DASHBOARD_PORT=3002
DASHBOARD_HOST=0.0.0.0
DASHBOARD_BASE_URL=http://localhost:3002
VITE_API_BASE_URL=http://localhost:3000
VITE_INFERENCE_BASE_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001

# ==================================
# SECURITY SETTINGS
# ==================================
JWT_SECRET=change_me_use_minimum_32_characters_random_string
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d
ENCRYPTION_KEY=change_me_exactly_32_characters!!
ENCRYPTION_ALGORITHM=aes-256-gcm
SESSION_SECRET=change_me_session_secret_string
BCRYPT_ROUNDS=12

# ==================================
# CORS & SECURITY HEADERS
# ==================================
CORS_ENABLED=true
CORS_CREDENTIALS=true
HELMET_ENABLED=true
CSRF_PROTECTION=false

# ==================================
# FEATURE FLAGS
# ==================================
ENABLE_CONSENT=true
ENABLE_AUTHENTICATION=true
ENABLE_COGNITIVE_LOAD_DETECTION=true
ENABLE_ANOMALY_DETECTION=true
ENABLE_REAL_TIME_INFERENCE=true
ENABLE_DASHBOARD_ANALYTICS=true
ENABLE_AUDIT_LOGGING=true
ENABLE_DATA_ANONYMIZATION=false

# ==================================
# LOGGING & MONITORING
# ==================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_TO_FILE=false
LOG_FILE_PATH=/var/log/behavioral-analytics
DEBUG_MODE=false
ENABLE_METRICS=true
METRICS_PORT=9090

# ==================================
# REDIS CONFIGURATION (Optional)
# ==================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# ==================================
# WEBSOCKET CONFIGURATION
# ==================================
WS_ENABLED=true
WS_PATH=/socket.io
WS_PING_TIMEOUT=60000
WS_PING_INTERVAL=25000

# ==================================
# DATA RETENTION & CLEANUP
# ==================================
DATA_RETENTION_DAYS=90
CLEANUP_INTERVAL_HOURS=24
ARCHIVE_OLD_DATA=false
ARCHIVE_PATH=/data/archives

# ==================================
# ML MODEL CONFIGURATION
# ==================================
MODEL_UPDATE_INTERVAL=86400000
MODEL_VALIDATION_THRESHOLD=0.85
MIN_TRAINING_SAMPLES=1000
FEATURE_WINDOW_SIZE=50
SEQUENCE_LENGTH=100

# ==================================
# PERFORMANCE TUNING
# ==================================
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=4096
UV_THREADPOOL_SIZE=128
CLUSTER_ENABLED=false
WORKERS=4

# ==================================
# NOTIFICATION SETTINGS
# ==================================
ENABLE_EMAIL_NOTIFICATIONS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
EMAIL_FROM=noreply@behavioral-analytics.com

# ==================================
# DOCKER CONFIGURATION
# ==================================
COMPOSE_PROJECT_NAME=behavioral-analytics
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ==================================
# DEVELOPMENT SETTINGS
# ==================================
HOT_RELOAD=false
AUTO_MIGRATION=false
SEED_DATABASE=false
MOCK_DATA_ENABLED=false
