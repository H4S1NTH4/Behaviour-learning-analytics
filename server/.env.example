# =================================
# Behavioral Analytics Server
# Environment Configuration Template
# =================================

# Node Environment
# Options: development, production, test
NODE_ENV=development

# =================================
# Database Configuration (PostgreSQL)
# =================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=behavioral_analytics
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_POOL_SIZE=20

# =================================
# Server Configuration
# =================================
API_PORT=3000

# =================================
# Security Settings
# =================================
# JWT secret for token signing (change in production!)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Encryption key for sensitive data (change in production!)
ENCRYPTION_KEY=your_encryption_key_change_in_production

# =================================
# Feature Flags
# =================================
# Enable GDPR consent tracking
ENABLE_CONSENT=true

# Enable debug logging
DEBUG_MODE=false

# =================================
# CORS Configuration
# =================================
# Allowed origins (comma-separated for multiple)
# Use * for development, specific domains for production
CORS_ORIGIN=*

# =================================
# Rate Limiting
# =================================
# Time window in milliseconds (default: 60000 = 1 minute)
RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# =================================
# Feature Extraction Configuration
# =================================
# Time window size for feature extraction (seconds)
FEATURE_WINDOW_SIZE=30

# Minimum events required per window
FEATURE_MIN_EVENTS=10

# =================================
# Continuous Authentication Configuration
# =================================
# Minimum sessions required for enrollment
AUTH_MIN_ENROLLMENT_SESSIONS=5

# Authentication check interval (seconds)
AUTH_CHECK_INTERVAL=60

# Similarity threshold (0.0 - 1.0)
AUTH_SIMILARITY_THRESHOLD=0.75

# Risk score threshold (0.0 - 1.0)
AUTH_RISK_THRESHOLD=0.7

# Enable automatic challenge on high risk
AUTH_ENABLE_CHALLENGE=true

# Enable automatic session lock on very high risk
AUTH_ENABLE_LOCK=false

# =================================
# Logging Configuration
# =================================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# Log to file
LOG_TO_FILE=false

# Log file path
LOG_FILE_PATH=./logs/server.log
